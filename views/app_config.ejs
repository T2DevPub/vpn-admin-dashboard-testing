<!DOCTYPE html>
<html>
<head>
    <title>App Config | VPN Admin</title>
    <link rel="icon" type="image/png" href="/images/t2vpn_icon.png">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#f3f4f6] text-gray-800 font-sans antialiased">
    <div class="flex h-screen overflow-hidden">
    <%- include('partials/sidebar', {activePage: 'appconfig'}) %>
        <div class="flex-1 flex flex-col ml-64 overflow-hidden">
            <%- include('partials/topbar', {pageTitle: 'Admin Panel', pageSubtitle: 'Manage your settings'}) %>
            <main class="flex-1 overflow-x-hidden overflow-y-auto bg-[#f8fafc] p-6 lg:p-8">

    <div class="p-8 max-w-4xl mx-auto">
        <h1 class="text-2xl font-bold mb-6 text-gray-800">Remote App Configuration</h1>

        <form action="/save-app-config" method="POST" class="bg-white p-6 rounded shadow space-y-6">

            <!-- Force Update Section -->
            <div>
                <h2 class="text-lg font-bold text-gray-700 mb-4 pb-2 border-b">Force App Update</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Minimum Allowed App Version</label>
                        <input type="text" name="forceUpdateVersion" class="w-full border rounded p-2 focus:ring focus:ring-blue-200" placeholder="e.g. 1.0.5" value="<%= config.forceUpdateVersion || '' %>">
                        <p class="text-xs text-gray-500 mt-1">Users on older versions will be forced to update.</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Play Store URL</label>
                        <input type="url" name="forceUpdateUrl" class="w-full border rounded p-2 focus:ring focus:ring-blue-200" placeholder="https://play.google.com/..." value="<%= config.forceUpdateUrl || '' %>">
                    </div>
                </div>
            </div>

            <!-- MOTD Section -->
            <div>
                <h2 class="text-lg font-bold text-gray-700 mb-4 pb-2 border-b">Message of the Day (MOTD)</h2>

                <div class="mb-4">
                    <label class="flex items-center">
                        <input type="checkbox" name="motdEnabled" class="form-checkbox h-5 w-5 text-blue-600 rounded" <%= config.motdEnabled === 1 ? 'checked' : '' %>>
                        <span class="ml-2 text-gray-700 font-medium">Enable MOTD inside Client Apps</span>
                    </label>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Message Content</label>
                    <textarea name="motdMessage" rows="3" class="w-full border rounded p-2 focus:ring focus:ring-blue-200" placeholder="Important announcement for all users..."><%= config.motdMessage || '' %></textarea>
                </div>
            </div>

            <div class="pt-4">
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded shadow transition w-full md:w-auto">
                    Save Configuration
                </button>
            </div>
        </form>
    </div>
            </main>
        </div>
    </div>
</body>
</html>