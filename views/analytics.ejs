<!DOCTYPE html>
<html>
<head>
    <title>Analytics | VPN Admin</title>
    <link rel="icon" type="image/png" href="/images/t2vpn_icon.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-[#f3f4f6] text-gray-800 font-sans antialiased">
    <div class="flex h-screen overflow-hidden">
    <%- include('partials/sidebar', {activePage: 'analytics'}) %>
        <div class="flex-1 flex flex-col ml-64 overflow-hidden">
            <%- include('partials/topbar', {pageTitle: 'Admin Panel', pageSubtitle: 'Manage your settings'}) %>
            <main class="flex-1 overflow-x-hidden overflow-y-auto bg-[#f8fafc] p-6 lg:p-8">

    <div class="p-8 max-w-6xl mx-auto">
        <h1 class="text-2xl font-bold mb-6 text-gray-800">Historical Analytics</h1>

        <div class="bg-white p-6 rounded shadow mb-8">
            <h2 class="text-lg font-semibold text-gray-700 mb-4">Active Users Over Time</h2>
            <div class="relative h-72">
                <canvas id="usersChart"></canvas>
            </div>
        </div>

        <div class="bg-white p-6 rounded shadow mb-8">
            <h2 class="text-lg font-semibold text-gray-700 mb-4">Bandwidth Consumption Over Time (GB)</h2>
            <div class="relative h-72">
                <canvas id="bandwidthChart"></canvas>
            </div>
        </div>
    </div>

    <script>
        // Use a dummy empty chart setup here for now to avoid JS errors if endpoint isn't fully wired for this view yet.
        // The endpoint logic for fetching historical arrays goes here in a future step.
        document.addEventListener('DOMContentLoaded', () => {
            const ctxUsers = document.getElementById('usersChart').getContext('2d');
            new Chart(ctxUsers, {
                type: 'line',
                data: {
                    labels: ['No Data Yet'],
                    datasets: [{
                        label: 'Active Users',
                        data: [0],
                        borderColor: 'rgb(59, 130, 246)',
                        tension: 0.1
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });

            const ctxBw = document.getElementById('bandwidthChart').getContext('2d');
            new Chart(ctxBw, {
                type: 'line',
                data: {
                    labels: ['No Data Yet'],
                    datasets: [{
                        label: 'Consumed Bandwidth (GB)',
                        data: [0],
                        borderColor: 'rgb(16, 185, 129)',
                        tension: 0.1
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });
        });
    </script>
            </main>
        </div>
    </div>
</body>
</html>