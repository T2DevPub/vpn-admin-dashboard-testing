<!-- Topbar -->
<header class="bg-white/80 backdrop-blur-md border-b border-gray-200 h-[72px] flex items-center justify-between px-8 z-10 sticky top-0">
    <div>
        <h2 class="text-[22px] font-extrabold text-gray-800 tracking-tight"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %></h2>
        <p class="text-[13px] text-gray-500 font-medium"><%= typeof pageSubtitle !== 'undefined' ? pageSubtitle : 'Overview of your VPN service, servers, users and network activity.' %></p>
    </div>
    <div class="flex items-center space-x-5">
        <div class="flex items-center bg-emerald-50 text-emerald-600 px-3 py-1.5 rounded-full text-xs font-bold border border-emerald-100 shadow-sm">
            <div class="w-2 h-2 bg-emerald-500 rounded-full mr-2 animate-pulse"></div>
            System Healthy
        </div>
        <button class="relative p-2 text-gray-500 hover:text-gray-700 bg-gray-50 hover:bg-gray-100 rounded-full transition-colors border border-gray-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
            <span class="absolute top-0 right-0 block h-2.5 w-2.5 rounded-full bg-red-500 ring-2 ring-white transform translate-x-1/4 -translate-y-1/4"></span>
        </button>
        <div class="flex items-center space-x-3 cursor-pointer hover:bg-gray-50 p-1.5 rounded-full pr-4 transition-colors">
            <div class="w-9 h-9 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold shadow-sm">
                A
            </div>
            <span class="font-semibold text-sm text-gray-700">Admin</span>
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </div>
    </div>
</header>