<!DOCTYPE html>
<html>
<head>
    <title>Ad Management | VPN Admin</title>
    <link rel="icon" type="image/png" href="/images/t2vpn_icon.png">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#f3f4f6] text-gray-800 font-sans antialiased">
    <div class="flex h-screen overflow-hidden">
    <%- include('partials/sidebar', {activePage: 'ads'}) %>
        <div class="flex-1 flex flex-col ml-64 overflow-hidden">
            <%- include('partials/topbar', {pageTitle: 'Admin Panel', pageSubtitle: 'Manage your settings'}) %>
            <main class="flex-1 overflow-x-hidden overflow-y-auto bg-[#f8fafc] p-6 lg:p-8">

    <div class="p-8 max-w-3xl mx-auto">
        <h1 class="text-2xl font-bold mb-6">Ad Management Configurations</h1>

        <form action="/ads" method="POST" class="bg-white p-6 rounded shadow">

            <h2 class="text-lg font-bold mb-4 border-b pb-2">Global Ad Placements</h2>

            <div class="space-y-4 mb-6">
                <label class="flex items-center justify-between p-3 border rounded hover:bg-gray-50">
                    <span class="text-gray-700 font-medium">Bottom Banner Ads</span>
                    <input type="checkbox" name="bannersEnabled" class="form-checkbox h-5 w-5 text-blue-600" <%= config.bannersEnabled ? 'checked' : '' %>>
                </label>

                <label class="flex items-center justify-between p-3 border rounded hover:bg-gray-50">
                    <span class="text-gray-700 font-medium">App Open Ads (Cold Start/Resume)</span>
                    <input type="checkbox" name="appOpenAdsEnabled" class="form-checkbox h-5 w-5 text-blue-600" <%= config.appOpenAdsEnabled ? 'checked' : '' %>>
                </label>

                <label class="flex items-center justify-between p-3 border rounded hover:bg-gray-50">
                    <span class="text-gray-700 font-medium">Interstitial on Connect</span>
                    <input type="checkbox" name="interstitialOnConnect" class="form-checkbox h-5 w-5 text-blue-600" <%= config.interstitialOnConnect ? 'checked' : '' %>>
                </label>

                <label class="flex items-center justify-between p-3 border rounded hover:bg-gray-50">
                    <span class="text-gray-700 font-medium">Interstitial on Disconnect</span>
                    <input type="checkbox" name="interstitialOnDisconnect" class="form-checkbox h-5 w-5 text-blue-600" <%= config.interstitialOnDisconnect ? 'checked' : '' %>>
                </label>
            </div>

            <h2 class="text-lg font-bold mb-4 border-b pb-2 mt-8">Ad Network Routing & IDs</h2>
            <div class="mb-6">
                <label class="block text-gray-700 mb-2">Primary Ad Network Provider</label>
                <select name="adNetworkProvider" id="adNetworkProvider" class="w-full border rounded p-2" onchange="toggleNetworkFields()">
                    <option value="AdMob" <%= config.adNetworkProvider === 'AdMob' ? 'selected' : '' %>>Google AdMob / AdX</option>
                    <option value="Meta" <%= config.adNetworkProvider === 'Meta' ? 'selected' : '' %>>Meta Audience Network</option>
                </select>
                <p class="text-sm text-gray-500 mt-2">This determines which SDK handles the primary ad requests on the Android client.</p>
            </div>

            <!-- AdMob Fields -->
            <div id="admobFields" class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                <div class="md:col-span-2"><h3 class="text-md font-semibold text-gray-700">Google AdMob / AdX IDs</h3></div>
                <div>
                    <label class="block text-gray-700 text-sm font-bold mb-1">Banner Ad Unit ID</label>
                    <input type="text" name="bannerAdUnitId" value="<%= config.bannerAdUnitId || '' %>" class="w-full border rounded p-2" placeholder="ca-app-pub-...">
                </div>
                <div>
                    <label class="block text-gray-700 text-sm font-bold mb-1">App Open Ad Unit ID</label>
                    <input type="text" name="appOpenAdUnitId" value="<%= config.appOpenAdUnitId || '' %>" class="w-full border rounded p-2" placeholder="ca-app-pub-...">
                </div>
                <div>
                    <label class="block text-gray-700 text-sm font-bold mb-1">Interstitial Ad Unit ID</label>
                    <input type="text" name="interstitialAdUnitId" value="<%= config.interstitialAdUnitId || '' %>" class="w-full border rounded p-2" placeholder="ca-app-pub-...">
                </div>
                <div>
                    <label class="block text-gray-700 text-sm font-bold mb-1">Rewarded Ad Unit ID</label>
                    <input type="text" name="rewardedAdUnitId" value="<%= config.rewardedAdUnitId || '' %>" class="w-full border rounded p-2" placeholder="ca-app-pub-...">
                </div>
            </div>

            <!-- Meta Fields -->
            <div id="metaFields" class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6 hidden">
                <div class="md:col-span-2"><h3 class="text-md font-semibold text-gray-700">Meta Audience Network IDs</h3></div>
                <div>
                    <label class="block text-gray-700 text-sm font-bold mb-1">Banner Ad Unit ID</label>
                    <input type="text" name="metaBannerAdUnitId" value="<%= config.metaBannerAdUnitId || '' %>" class="w-full border rounded p-2" placeholder="YOUR_PLACEMENT_ID">
                </div>
                <div>
                    <label class="block text-gray-700 text-sm font-bold mb-1">App Open Ad Unit ID</label>
                    <input type="text" name="metaAppOpenAdUnitId" value="<%= config.metaAppOpenAdUnitId || '' %>" class="w-full border rounded p-2" placeholder="YOUR_PLACEMENT_ID">
                </div>
                <div>
                    <label class="block text-gray-700 text-sm font-bold mb-1">Interstitial Ad Unit ID</label>
                    <input type="text" name="metaInterstitialAdUnitId" value="<%= config.metaInterstitialAdUnitId || '' %>" class="w-full border rounded p-2" placeholder="YOUR_PLACEMENT_ID">
                </div>
                <div>
                    <label class="block text-gray-700 text-sm font-bold mb-1">Rewarded Ad Unit ID</label>
                    <input type="text" name="metaRewardedAdUnitId" value="<%= config.metaRewardedAdUnitId || '' %>" class="w-full border rounded p-2" placeholder="YOUR_PLACEMENT_ID">
                </div>
            </div>

            <div class="mt-8">
                <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 font-bold w-full">Save Ad Settings</button>
            </div>
        </form>
    </div>

    <script>
        function toggleNetworkFields() {
            const provider = document.getElementById('adNetworkProvider').value;
            const admobFields = document.getElementById('admobFields');
            const metaFields = document.getElementById('metaFields');

            if (provider === 'AdMob') {
                admobFields.classList.remove('hidden');
                metaFields.classList.add('hidden');
            } else if (provider === 'Meta') {
                admobFields.classList.add('hidden');
                metaFields.classList.remove('hidden');
            }
        }

        // Run once on load to set initial state
        toggleNetworkFields();
    </script>
            </main>
        </div>
    </div>
</body>
</html>
